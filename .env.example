# Copy to .env (gitignored) next to main.py; scripts/start.sh sources it, a systemd unit can use it
# as EnvironmentFile (so keep comments on their own lines). All settings: README.md -> Configuration.

# --- Required ---------------------------------------------------------------
# Password of the admin account (user "admin"), >= 20 chars. Not needed once the admin set its own.
NEWS_AUTH_PASSWORD='change-me-to-a-long-random-password'

# --- Server -----------------------------------------------------------------
# Bind address (default 127.0.0.1 = this machine only; 0.0.0.0 = all interfaces) and port
# NEWS_HOST=0.0.0.0
# NEWS_PORT=8787
# Public URL behind HTTPS: Secure cookie, HSTS, CSRF origin check
# NEWS_PUBLIC_BASE=https://news.example.org
# Reverse proxy whose X-Forwarded-* headers are trusted
# NEWS_FORWARDED_ALLOW_IPS=127.0.0.1
# NEWS_LOG_FILE=server.log

# --- Model server: llama.cpp (OpenAI-compatible /v1) or Ollama ----------------
# Check a new model with scripts/benchmark/model_check.py before switching (README "Swapping models").
# Option A — llama.cpp (`llama serve` / `llama-server`, LLM on GPU :11434, embeddings on CPU :11430):
NEWS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NEWS_LLM_API_KEY=
NEWS_CHAT_MODEL=qwen3-27b-IQ3
NEWS_LLM_STRUCTURED_EXTRA='{"chat_template_kwargs":{"enable_thinking":false}}'
NEWS_EMBED_BASE_URL=http://127.0.0.1:11430/v1
# NEWS_EMBED_API_KEY=
NEWS_EMBED_MODEL=qwen3-embedding
NEWS_EMBED_DIM=1024

# Option B — Ollama native (comment out NEWS_LLM_BASE_URL and NEWS_EMBED_BASE_URL above):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# NEWS_CHAT_MODEL=qwen3:14b
# NEWS_EMBED_MODEL=qwen3-embedding:0.6b
# NEWS_OLLAMA_KEEP_ALIVE=15m

# Optional per-role LLM overrides (empty = NEWS_CHAT_MODEL):
# NEWS_VERIFY_MODEL=
# NEWS_ASSESS_MODEL=
# NEWS_STORY_MODEL=

# --- Personalization defaults (users can override in Preferences) ------------
# NEWS_USER_CITY=Hamburg
# NEWS_USER_COUNTRY=Germany
# NEWS_USER_LANGUAGE=de

# --- Optional services ----------------------------------------------------------
# SearXNG with the JSON format enabled; empty = chat without web search
# NEWS_SEARCHNGX_BASE_URL=https://searx.example.org/
# NEWS_SEARCHNGX_API_KEY=
# ntfy topic for the daily brief and reports (unguessable topic or access token)
# NEWS_HEADS_UP_NTFY_URL=https://ntfy.sh/your-unguessable-topic
# NEWS_HEADS_UP_NTFY_TIMES=07:00
# Umami/Tianji-style analytics script, added to every page and to the CSP
# NEWS_ANALYTICS_SCRIPT_URL=https://analytics.example.org/script.js
# NEWS_ANALYTICS_WEBSITE_ID=
